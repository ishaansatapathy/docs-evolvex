{
  "theme": "default",
  "appearance": {
    "contentIcons": "accent"
  },
  "markdown": {
    "enabled": true
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      {
        "code": "en",
        "label": "English"
      }
    ]
  },
  "banner": {
    "content": "Evolvex v1.0.0 is live! Autonomous incident investigations on SigNoz with eBPF, K8s, and Git correlation.",
    "type": "info",
    "dismissible": true,
    "id": "evolvex-v1-launch"
  },
  "fonts": {
    "body": {
      "family": "Inter",
      "weight": ["400", "500", "600", "700"]
    },
    "heading": {
      "family": "Inter",
      "weight": ["600", "700", "800"]
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "analytics": {
    "enabled": true
  },
  "admin": {
    "enabled": true
  },
  "team": {
    "members": [
      {
        "email": "ishaan@evolvex.io",
        "role": "owner"
      }
    ]
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "/quickstart",
      "permanent": true
    },
    {
      "source": "/install",
      "destination": "/quickstart",
      "permanent": true
    },
    {
      "source": "/signoz",
      "destination": "/guides/signoz-setup",
      "permanent": true
    },
    {
      "source": "/ebpf",
      "destination": "/guides/ebpf-obi",
      "permanent": true
    }
  ],
  "navbar": {
    "primary": {
      "label": "Get started",
      "href": "/quickstart"
    },
    "links": [
      {
        "label": "Live Console",
        "href": "https://evolvex.ishaandev.co.in"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/ishaansatapathy/EvolveX"
      },
      {
        "label": "SigNoz Cloud",
        "href": "https://signoz.io"
      },
      {
        "label": "Built on Thally",
        "href": "https://github.com/thallylabs/thally"
      }
    ]
  },
  "tracking": {
    "repos": [
      {
        "owner": "ishaansatapathy",
        "repo": "EvolveX",
        "branch": "main",
        "paths": [
          "apps/web/**",
          "apps/worker/**",
          "packages/sdk/**",
          "helm/**",
          "scripts/**"
        ],
        "outputTab": "Guides",
        "outputGroup": "Operations & Automation"
      }
    ]
  },
  "apiPlayground": {
    "credentials": {
      "apiKeyAuth": "evx_live_evaluator_key_secret",
      "basicAuth": "evolvex-signoz-webhook-token"
    }
  },
  "feedback": {
    "thumbsRating": true
  },
  "ai": {
    "chat": true,
    "label": "Ask EvolvexAI",
    "systemPrompt": "You are EvolvexAI, an expert autonomous reliability engineering agent. Assist users with incident investigation workflows, SigNoz OpenTelemetry tracing, eBPF kernel drops, Kubernetes agent deployment, and Evolvex SDK integration."
  },
  "tabs": [
    {
      "tab": "Get started",
      "groups": [
        {
          "group": "Get started",
          "pages": [
            "introduction",
            "quickstart"
          ]
        },
        {
          "group": "Architecture & Engine",
          "pages": [
            "guides/architecture",
            "guides/ebpf-obi",
            "guides/signoz-mcp"
          ]
        }
      ]
    },
    {
      "tab": "Integrations",
      "groups": [
        {
          "group": "Telemetry & Clusters",
          "pages": [
            "guides/signoz-setup",
            "guides/kubernetes"
          ]
        },
        {
          "group": "Collaboration & Git",
          "pages": [
            "guides/github-integration",
            "guides/slack-jira",
            "guides/cicd-and-flags"
          ]
        },
        {
          "group": "Extensibility & Plugins",
          "pages": [
            "guides/plugins-and-webhooks"
          ]
        }
      ]
    },
    {
      "tab": "Guides",
      "groups": [
        {
          "group": "Operations & Automation",
          "pages": [
            "guides/postmortem-and-dashboards",
            "guides/troubleshooting",
            "guides/telemetry-intelligence",
            "guides/work-with-the-cli"
          ]
        },
        {
          "group": "Developer Tools & SDK",
          "pages": [
            "guides/sdk-and-custom-events",
            "guides/create-a-site",
            "guides/connect-ai-tools"
          ]
        },
        {
          "group": "Documentation Design",
          "pages": [
            "components",
            "customization"
          ]
        },
        {
          "group": "System",
          "hidden": true,
          "pages": [
            "404"
          ]
        }
      ]
    },
    {
      "tab": "API Reference",
      "groups": [
        {
          "group": "Overview",
          "pages": [
            "api/introduction",
            "api/authentication"
          ]
        }
      ],
      "api": {
        "source": "openapi.yaml"
      }
    },
    {
      "tab": "Changelog",
      "href": "/changelog"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/ishaansatapathy/EvolveX"
    }
  }
}

